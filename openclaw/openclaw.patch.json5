// Ajustes do ~/.openclaw/openclaw.json por cima do que o `openclaw onboard` gera.
// Aplicar:  openclaw config patch --file ~/nixos-sway/openclaw/openclaw.patch.json5 [--dry-run]
// Sem segredos aqui: o token do Gateway fica só no ~/.openclaw (0600).
// Chaves conferidas em `openclaw config schema` (OpenClaw 2026.8.33).
{
  models: {
    providers: {
      "llama-local": {
        baseUrl: "http://127.0.0.1:8080/v1",
        api: "openai-completions",
        // Prefill a frio do system prompt do agente leva ~40–75 s na RX 580
        timeoutSeconds: 300,
        models: [
          {
            id: "qwen3.5-9b",                    // = --alias do llama-server (/v1/models)
            name: "Qwen3.5 9B Q4_K_M (llama.cpp Vulkan)",
            contextWindow: 32768,                 // = --ctx-size; o onboard pôs 128000
            maxTokens: 8192,                      // thinking + resposta/tool call
            input: ["text"],
            reasoning: true,                      // Qwen3.5 pensa por padrão (<think>)
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            compat: {
              supportsTools: true,                // llama-server --jinja
              // /think off → chat_template_kwargs.enable_thinking=false
              thinkingFormat: "qwen-chat-template",
            },
          },
        ],
      },
    },
  },

  // Padrão do OpenClaw é executar tudo sem perguntar (security=full, ask=off).
  // mode "ask": allowlist roda direto, o resto vai para aprovação humana.
  // (não usar "auto": aí um classificador/LLM aprova no seu lugar)
  // security/ask são as chaves legadas; null as remove.
  tools: {
    exec: {
      mode: "ask",
      security: null,
      ask: null,
    },
    // security audit (CRITICAL models.small_params): modelo pequeno + conteúdo
    // web = prompt injection fácil. Sem web/browser para o modelo local.
    byProvider: {
      "llama-local/qwen3.5-9b": { deny: ["group:web", "browser"] },
    },
    // Ações privilegiadas: desligadas até haver um caso de uso explícito.
    elevated: { enabled: false },
    // read/write/edit/apply_patch NÃO passam pela aprovação de exec; sem isto
    // (padrão false) o agente lê/escreve tudo que o arthur pode (~/.ssh, token...).
    fs: { workspaceOnly: true },
    // Ferramentas que não servem para programar (e custam tokens a cada turno)
    deny: ["dashboard", "conversations_list", "conversations_send",
           "conversations_turn", "create_goal"],
  },

  // Workspace = pasta de projetos. Na raiz ficam os arquivos do agente
  // (AGENTS.md, SOUL.md...); cada projeto numa subpasta com o próprio git.
  // Prompt do agente medido: ~22k de 32k tokens (30 ferramentas + ~8,5k de
  // system prompt) → 3 min de prefill a 117 tok/s. Enxugando para modelo local:
  agents: {
    defaults: {
      workspace: "/home/arthur/projetos",
      // docs gateway/local-models: tira browser, automations, message,
      // image/music/video_generate, tts, pdf
      experimental: { localModelLean: true },
      // Turnos com prefill a frio + tool calls passam de 7 min neste hardware
      timeoutSeconds: 900,
      // Com janela de 32k, o "pre-compaction memory flush" disparava depois de
      // TODO turno (chamada extra de ~7k tokens, ~50 s, sem cache). Memória
      // semântica já está off; o schema recomenda desligar em ambiente limitado.
      compaction: {
        memoryFlush: { enabled: false },
        // Auto-compactação já é padrão, mas falhava: timeout de 180 s e ~18k
        // tokens de histórico (~160 s só de prefill na RX 580) + o resumo.
        timeoutSeconds: 600,
        thinkingLevel: "off",             // resumo não precisa de <think> (padrão "low")
        qualityGuard: { enabled: false }, // auditoria pode regenerar = dobra o tempo
        notifyUser: true,                 // "🧹 Compacting context..." no chat
      },
      // Heartbeat: automação a cada 30 min que acorda o agente "proativamente".
      // Sem canais de chat ela é pulada (no-route), mas já rodou um turno que
      // encheu os 32k de contexto. "0m" desliga a cadência (docs gateway/heartbeat).
      heartbeat: { every: "0m" },
      // Allowlist de skills (eram 20 no prompt: meme-maker, weather, notion,
      // clawhub...). Só as úteis para código.
      skills: ["spike", "node-inspect-debugger"],
    },
    entries: { main: { workspace: "/home/arthur/projetos" } },
  },

  // Provider padrão de embeddings é "openai" (sem chave aqui); desliga para
  // não haver tentativa de chamada externa. Embeddings locais: fase futura.
  memory: {
    search: { enabled: false, rememberAcrossConversations: false },
  },

  // "Dreaming": job noturno (3h) do plugin memory-core que consolida memórias
  // usando o modelo. Sem memória semântica não faz nada útil e ocuparia o
  // llama-server/GPU de madrugada.
  plugins: {
    entries: {
      "memory-core": { config: { dreaming: { enabled: false } } },
    },
  },

  // Skill Workshop: padrão "auto" = o agente cria/reescreve as próprias skills
  // em segundo plano a partir das conversas (e roda jobs que ocupam o modelo).
  // Com modelo pequeno + prompt injection, isso vira persistência de instruções
  // maliciosas. Desligado; qualquer proposta exige aprovação.
  skills: {
    workshop: {
      autonomous: { mode: "off" },
      approvalPolicy: "pending",
    },
  },

  // Não criar bloco `browser`: qualquer config ali faz o `doctor --fix`
  // habilitar a ferramenta de navegador. O aviso de relay legado é inócuo
  // sem extensões pareadas. (null remove, caso tenha sido criado antes)
  browser: null,
}
