# =============================================================================
#  ~/.config/sway/config — ricing minimalista (preto + vermelho)
#  Atalhos espelhados no niri do Void. Veja todos com: Super+Shift+/
# =============================================================================

set $mod   Mod4
set $term  alacritty
set $menu  fuzzel
set $lock  swaylock -f

# Paleta
set $bg     #121010
set $fg     #8a7f7c
set $fg_hi  #e2d2c0
set $line   #2e2424
set $accent #e0533d
set $urgent #e5a04b

# ------------------------------- aparência -----------------------------------
font pango:JetBrainsMono Nerd Font 10

default_border pixel 2
default_floating_border pixel 2
smart_borders off
gaps inner 4
gaps outer 2

# --- SwayFX: cantos, sombras, blur, escurecer inativas ---
corner_radius 0
shadows enable
shadows_on_csd disable
shadow_blur_radius 20
shadow_color #0000009a
blur enable
blur_xray disable
blur_passes 2
blur_radius 4
default_dim_inactive 0.08
dim_inactive_colors.unfocused #000000ff
dim_inactive_colors.urgent    #e5a04bff
# Blur/cantos atrás da barra, notificações e launcher
layer_effects "waybar" blur enable; blur_ignore_transparent enable; shadows disable
layer_effects "notifications" blur enable; shadows enable
layer_effects "launcher" blur enable; shadows enable

#                       borda    fundo  texto   indicador filho
client.focused          $accent  $bg    $fg_hi  $accent   $accent
client.focused_inactive $line    $bg    $fg     $line     $line
client.unfocused        $line    $bg    $fg     $line     $line
client.urgent           $urgent  $bg    $fg_hi  $urgent   $urgent

# Wallpaper (vem de dotfiles/sway/wallpaper.png)
output * bg ~/.config/sway/wallpaper.png fill $bg

# --------------------------------- monitores ---------------------------------
# Identificados por marca/modelo/serial (não mudam se trocar de porta).
# Principal: AOC 24G4 (DP) a 180 Hz, embaixo.
# Secundário: AOC 24G2E1 (HDMI) a 100 Hz, em cima, montado de ponta-cabeça.
set $main "AOC 24G4 12VPAXA009928"
set $side "AOC 24G2E1 12XP3XA001455"

output $main mode 1920x1080@180.003Hz position 0 1080
output $side mode 1920x1080@100Hz     position 0 0 transform 180

# Workspaces 1–5 no principal, 6–9 no secundário
workspace 1 output $main
workspace 2 output $main
workspace 3 output $main
workspace 4 output $main
workspace 5 output $main
workspace 6 output $side
workspace 7 output $side
workspace 8 output $side
workspace 9 output $side

# --------------------------------- entrada -----------------------------------
input type:keyboard {
    xkb_layout br
    repeat_delay 300
    repeat_rate 40
}

# Cursor (tema instalado pelo configuration.nix)
seat seat0 xcursor_theme capitaine-cursors 24

input type:pointer {
    accel_profile flat
}

input type:touchpad {
    tap enabled
    natural_scroll enabled
}

# ------------------------------- inicialização -------------------------------
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP=sway
exec waybar
# novas janelas em espiral (alterna split h/v)
exec autotiling-rs
exec mako
exec /etc/polkit-gnome-agent
# Sem bloqueio/desligamento de tela automático: bloquear (Super+Alt+L) e
# suspender (menu de energia, Super+Shift+E) são manuais. O swayidle só
# garante que a tela seja bloqueada quando você mandar suspender.
exec swayidle -w before-sleep '$lock'

# ------------------------------ regras de janela -----------------------------
for_window [app_id="pavucontrol"] floating enable
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable
for_window [app_id="nm-connection-editor"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_type="dialog"] floating enable

floating_modifier $mod normal

# =============================================================================
#  ATALHOS (iguais ao niri)
# =============================================================================

# --- Básico ---
bindsym $mod+t exec $term
bindsym $mod+d exec $menu
bindsym $mod+space exec $menu
bindsym $mod+q kill
bindsym $mod+Alt+l exec $lock
bindsym $mod+Shift+e exec ~/.config/waybar/scripts/powermenu.sh
# tecla física "/" (bindcode = posição, independe do layout br)
bindcode $mod+Shift+61 exec ~/.config/sway/scripts/keybinds.sh
bindsym $mod+Shift+c reload

# --- Foco (niri: Super + setas / HJKL) ---
bindsym $mod+Left  focus left
bindsym $mod+Right focus right
bindsym $mod+Up    focus up
bindsym $mod+Down  focus down
bindsym $mod+h focus left
bindsym $mod+l focus right
bindsym $mod+k focus up
bindsym $mod+j focus down

# --- Mover janela (niri: Super + Ctrl + setas / HJKL) ---
bindsym $mod+Ctrl+Left  move left
bindsym $mod+Ctrl+Right move right
bindsym $mod+Ctrl+Up    move up
bindsym $mod+Ctrl+Down  move down
bindsym $mod+Ctrl+h move left
bindsym $mod+Ctrl+l move right
bindsym $mod+Ctrl+k move up
bindsym $mod+Ctrl+j move down

# --- Monitores (niri: Super + Shift + setas) ---
bindsym $mod+Shift+Left  focus output left
bindsym $mod+Shift+Right focus output right
bindsym $mod+Shift+Up    focus output up
bindsym $mod+Shift+Down  focus output down
bindsym $mod+Shift+Ctrl+Left  move container to output left
bindsym $mod+Shift+Ctrl+Right move container to output right
bindsym $mod+Shift+Ctrl+Up    move container to output up
bindsym $mod+Shift+Ctrl+Down  move container to output down

# --- Workspaces (niri: Super + N foca, Super + Ctrl + N move) ---
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+Ctrl+1 move container to workspace number 1
bindsym $mod+Ctrl+2 move container to workspace number 2
bindsym $mod+Ctrl+3 move container to workspace number 3
bindsym $mod+Ctrl+4 move container to workspace number 4
bindsym $mod+Ctrl+5 move container to workspace number 5
bindsym $mod+Ctrl+6 move container to workspace number 6
bindsym $mod+Ctrl+7 move container to workspace number 7
bindsym $mod+Ctrl+8 move container to workspace number 8
bindsym $mod+Ctrl+9 move container to workspace number 9

# Próxima/anterior (niri: Super + PageDown/PageUp ou U/I)
bindsym $mod+Page_Down workspace next_on_output
bindsym $mod+Page_Up   workspace prev_on_output
bindsym $mod+u workspace next_on_output
bindsym $mod+i workspace prev_on_output
bindsym $mod+Ctrl+Page_Down move container to workspace next_on_output
bindsym $mod+Ctrl+Page_Up   move container to workspace prev_on_output
bindsym $mod+Ctrl+u move container to workspace next_on_output
bindsym $mod+Ctrl+i move container to workspace prev_on_output

# Roda do mouse com Super troca de workspace (igual ao niri)
bindsym --whole-window $mod+button5 workspace next_on_output
bindsym --whole-window $mod+button4 workspace prev_on_output

# --- Layout ---
# niri Super+F (maximizar coluna) e Super+Shift+F (tela cheia): no Sway, ambos = tela cheia
bindsym $mod+f       fullscreen toggle
bindsym $mod+Shift+f fullscreen toggle
# niri Super+W (coluna em abas)
bindsym $mod+w       layout toggle tabbed split
# niri Super+V / Super+Shift+V (flutuante)
bindsym $mod+v       floating toggle
bindsym $mod+Shift+v focus mode_toggle
# niri Super+[ / Super+] (consume/expel): no Sway, divide horizontal/vertical
# teclas físicas "[" e "]" (no layout br elas viram acento/[)
bindcode $mod+34 splith
bindcode $mod+35 splitv

# Tamanho (niri: Super + - / =, Super + R para larguras)
bindsym $mod+minus       resize shrink width 10 ppt
bindsym $mod+equal       resize grow width 10 ppt
bindsym $mod+Shift+minus resize shrink height 10 ppt
bindsym $mod+Shift+equal resize grow height 10 ppt
bindsym $mod+r mode "resize"

mode "resize" {
    bindsym Left  resize shrink width 20px
    bindsym Right resize grow width 20px
    bindsym Up    resize shrink height 20px
    bindsym Down  resize grow height 20px
    bindsym h resize shrink width 20px
    bindsym l resize grow width 20px
    bindsym k resize shrink height 20px
    bindsym j resize grow height 20px
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

# --- Screenshots (niri: PrtSc área, Ctrl+PrtSc tela, Alt+PrtSc janela) ---
bindsym Print      exec ~/.config/sway/scripts/screenshot.sh area
bindsym Ctrl+Print exec ~/.config/sway/scripts/screenshot.sh screen
bindsym Alt+Print  exec ~/.config/sway/scripts/screenshot.sh window

# --- Mídia, volume e brilho ---
bindsym --locked XF86AudioRaiseVolume  exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume  exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute         exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute      exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86AudioPlay         exec playerctl play-pause
bindsym --locked XF86AudioNext         exec playerctl next
bindsym --locked XF86AudioPrev         exec playerctl previous
bindsym --locked XF86MonBrightnessUp   exec brightnessctl set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-

include /etc/sway/config.d/*
