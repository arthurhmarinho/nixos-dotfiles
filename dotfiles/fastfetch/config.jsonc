// ~/.config/fastfetch/config.jsonc — aparece ao abrir o terminal (fish_greeting)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "nixos_small",
    "color": { "1": "#e0533d", "2": "#942e17", "3": "#e0533d", "4": "#942e17", "5": "#e0533d", "6": "#942e17" },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "#e0533d", "title": "#e0533d" },
    "key": { "width": 10 },
    "percent": { "color": { "green": "#e2d2c0", "yellow": "#e5a04b", "red": "#e0533d" } }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "custom", "format": "\u001b[38;2;46;36;36m──────────────────────────\u001b[0m" },
    { "type": "os",       "key": "󱄅 os",    "format": "{name} {version-id}" },
    { "type": "kernel",   "key": "󰌽 kernel" },
    { "type": "wm",       "key": "󰖲 wm" },
    { "type": "shell",    "key": "󰆍 shell" },
    { "type": "packages", "key": "󰏖 pkgs" },
    { "type": "uptime",   "key": "󰅐 uptime" },
    { "type": "cpu",      "key": "󰻠 cpu",  "format": "{name}" },
    { "type": "gpu",      "key": "󰢮 gpu",  "format": "{name}" },
    { "type": "memory",   "key": "󰍛 ram" },
    { "type": "disk",     "key": "󰋊 disk", "folders": "/" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 1 }
  ]
}
