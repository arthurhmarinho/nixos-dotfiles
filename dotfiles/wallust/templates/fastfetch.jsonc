// Gerado pelo wallust (dotfiles/wallust/templates/fastfetch.jsonc) — não editar
// ~/.config/fastfetch/config.jsonc — aparece ao abrir o terminal (fish_greeting)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "nixos_small",
    "color": { "1": "{{color1}}", "2": "{{color1 | darken(0.35)}}", "3": "{{color1}}", "4": "{{color1 | darken(0.35)}}", "5": "{{color1}}", "6": "{{color1 | darken(0.35)}}" },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "{{color1}}", "title": "{{color1}}" },
    "key": { "width": 10 },
    "percent": { "color": { "green": "{{foreground}}", "yellow": "{{color11}}", "red": "{{color1}}" } }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "custom", "format": "\u001b[38;2;{{background | lighten(0.10) | rgb | replace(",", ";")}}m──────────────────────────\u001b[0m" },
    { "type": "os",       "key": "󱄅 os",    "format": "{name} {version-id}" },
    { "type": "kernel",   "key": "󰌽 kernel" },
    { "type": "wm",       "key": "󰖲 wm" },
    { "type": "shell",    "key": "󰆍 shell" },
    { "type": "packages", "key": "󰏖 pkgs" },
    { "type": "uptime",   "key": "󰅐 uptime" },
    { "type": "cpu",      "key": "󰻠 cpu",  "format": "{name}" },
    { "type": "gpu",      "key": "󰢮 gpu",  "format": "{name}" },
    { "type": "memory",   "key": "󰍛 ram" },
    { "type": "disk",     "key": "󰋊 disk", "folders": "/" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 1 }
  ]
}
