# ~/.config/mako/config — cores geradas pelo wallust a partir do wallpaper
include=~/.cache/wallust/mako

font=JetBrainsMono Nerd Font 10
icon-path=/run/current-system/sw/share/icons/MacTahoe-red-dark
max-icon-size=40
border-size=1
border-radius=12
padding=12
margin=12
outer-margin=8
width=340
anchor=top-right
default-timeout=5000

[urgency=high]
default-timeout=0
