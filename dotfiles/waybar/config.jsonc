// ~/.config/waybar/config.jsonc — barra vertical à esquerda, ilhas arredondadas
// (só no monitor principal)
{
  "layer": "top",
  "position": "left",
  "output": "DP-1",
  "width": 30,
  "margin-top": 4,
  "margin-bottom": 4,
  "margin-left": 4,
  "spacing": 6,

  // cpu, memory, custom/gpu e clock: no arquivo gerado pelo wallust (o texto
  // deles leva cores Pango, que o CSS não alcança)
  "include": ["~/.cache/wallust/waybar-modules.jsonc"],

  "modules-left":   ["custom/launcher", "sway/workspaces", "custom/focused", "sway/mode", "sway/scratchpad"],
  "modules-center": ["mpris"],
  "modules-right":  ["group/stats", "group/system", "clock", "custom/settings", "custom/power"],

  // ------------------------------- grupos (ilhas) -------------------------------
  "group/stats": {
    "orientation": "vertical",
    "modules": ["cpu", "temperature#cpu", "custom/gpu", "temperature#gpu", "memory"]
  },
  "group/system": {
    "orientation": "vertical",
    "modules": ["tray", "bluetooth", "network", "pulseaudio"]
  },

  // ------------------------------------ topo ------------------------------------
  "custom/launcher": {
    "format": "󱄅",
    "tooltip": false,
    "on-click": "fuzzel"
  },
  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "format": "{name}"
  },
  "custom/focused": {
    // programa em foco: ícone escolhido pelo app e pelo título (scripts/focused.sh)
    "exec": "~/.config/waybar/scripts/focused.sh",
    "return-type": "json",
    "restart-interval": 5
  },
  "sway/mode": {
    "format": "󰩨",
    "tooltip-format": "modo: {}"
  },
  "sway/scratchpad": {
    "format": "󰖲",
    "show-empty": false,
    "tooltip-format": "{app}: {title}"
  },

  // ----------------------------------- centro -----------------------------------
  "mpris": {
    "format": "{player_icon}",
    "format-paused": "{status_icon}",
    "player-icons": { "default": "󰎈", "spotify": "󰓇", "firefox": "󰈹" },
    "status-icons": { "paused": "󰏤" },
    "tooltip-format": "{player}: {artist} – {title}",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },

  // ------------------------------------ base ------------------------------------
  "temperature#cpu": {
    // k10temp (Ryzen) — caminho fixo, não muda entre boots
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 85,
    "format": "{temperatureC}°",
    "justify": "center",
    "tooltip-format": "CPU: {temperatureC}°C"
  },
  "temperature#gpu": {
    // amdgpu (RX580)
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:01.1/0000:01:00.0/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 85,
    "format": "{temperatureC}°",
    "justify": "center",
    "tooltip-format": "GPU: {temperatureC}°C"
  },
  "tray": {
    "icon-size": 13,
    "spacing": 6
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "format-no-controller": "",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}"
  },
  "network": {
    "format-ethernet": "󰈀",
    "format-wifi": "{icon}",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "format-disconnected": "󰤮",
    "tooltip-format-ethernet": "{ifname}  {ipaddr}\n󰇚 {bandwidthDownBytes}  󰕒 {bandwidthUpBytes}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)  {ipaddr}\n󰇚 {bandwidthDownBytes}  󰕒 {bandwidthUpBytes}",
    "tooltip-format-disconnected": "Sem conexão",
    "interval": 5,
    "on-click": "alacritty -e nmtui"
  },
  "pulseaudio": {
    "format": "{icon}\n{volume}",
    "format-muted": "󰝟",
    "format-icons": { "headphone": "󰋋", "default": ["󰕿", "󰖀", "󰕾"] },
    "justify": "center",
    "tooltip-format": "{desc}: {volume}%",
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "custom/settings": {
    "format": "󰒓",
    "tooltip-format": "Configurações (Super+,)",
    "on-click": "~/.config/waybar/scripts/settings.sh"
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/powermenu.sh"
  }
}
