// ~/.config/waybar/config.jsonc — barra vertical à esquerda, ilhas arredondadas
// (só no monitor principal)
{
  "layer": "top",
  "position": "left",
  "output": "DP-1",
  "width": 40,
  "margin-top": 8,
  "margin-bottom": 8,
  "margin-left": 6,
  "spacing": 8,

  "modules-left":   ["custom/launcher", "sway/workspaces", "sway/mode", "sway/scratchpad"],
  "modules-center": ["mpris"],
  "modules-right":  ["group/stats", "group/system", "clock", "custom/power"],

  // ------------------------------- grupos (ilhas) -------------------------------
  "group/stats": {
    "orientation": "vertical",
    "modules": ["cpu", "temperature#cpu", "memory", "custom/gpu", "temperature#gpu"]
  },
  "group/system": {
    "orientation": "vertical",
    "modules": ["tray", "bluetooth", "network", "pulseaudio"]
  },

  // ------------------------------------ topo ------------------------------------
  "custom/launcher": {
    "format": "󱄅",
    "tooltip": false,
    "on-click": "fuzzel"
  },
  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "format": "{name}"
  },
  "sway/mode": {
    "format": "󰩨",
    "tooltip-format": "modo: {}"
  },
  "sway/scratchpad": {
    "format": "󰖲",
    "show-empty": false,
    "tooltip-format": "{app}: {title}"
  },

  // ----------------------------------- centro -----------------------------------
  "mpris": {
    "format": "{player_icon}",
    "format-paused": "{status_icon}",
    "player-icons": { "default": "󰎈", "spotify": "󰓇", "firefox": "󰈹" },
    "status-icons": { "paused": "󰏤" },
    "tooltip-format": "{player}: {artist} – {title}",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },

  // ------------------------------------ base ------------------------------------
  "cpu": {
    "format": "󰻠\n{usage}",
    "justify": "center",
    "interval": 3,
    "tooltip-format": "CPU: {usage}%",
    "on-click": "alacritty -e htop"
  },
  "temperature#cpu": {
    // k10temp (Ryzen) — caminho fixo, não muda entre boots
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 85,
    "format": "{temperatureC}°",
    "justify": "center",
    "tooltip-format": "CPU: {temperatureC}°C"
  },
  "memory": {
    "format": "󰍛\n{percentage}",
    "justify": "center",
    "interval": 5,
    "tooltip-format": "RAM: {used:0.1f} / {total:0.1f} GiB"
  },
  "custom/gpu": {
    "exec": "cat /sys/class/drm/card*/device/gpu_busy_percent 2>/dev/null | head -1",
    "format": "󰢮\n{}",
    "justify": "center",
    "interval": 3,
    "tooltip": false
  },
  "temperature#gpu": {
    // amdgpu (RX580)
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:01.1/0000:01:00.0/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 85,
    "format": "{temperatureC}°",
    "justify": "center",
    "tooltip-format": "GPU: {temperatureC}°C"
  },
  "tray": {
    "icon-size": 15,
    "spacing": 8
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "format-no-controller": "",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}"
  },
  "network": {
    "format-ethernet": "󰈀",
    "format-wifi": "{icon}",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "format-disconnected": "󰤮",
    "tooltip-format-ethernet": "{ifname}  {ipaddr}\n󰇚 {bandwidthDownBytes}  󰕒 {bandwidthUpBytes}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)  {ipaddr}\n󰇚 {bandwidthDownBytes}  󰕒 {bandwidthUpBytes}",
    "tooltip-format-disconnected": "Sem conexão",
    "interval": 5,
    "on-click": "alacritty -e nmtui"
  },
  "pulseaudio": {
    "format": "{icon}\n{volume}",
    "format-muted": "󰝟",
    "format-icons": { "headphone": "󰋋", "default": ["󰕿", "󰖀", "󰕾"] },
    "justify": "center",
    "tooltip-format": "{desc}: {volume}%",
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "clock": {
    "format": "{:%H\n%M}",
    "justify": "center",
    "interval": 30,
    "tooltip-format": "<b>{:%A, %d de %B}</b>\n\n<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months":   "<span color='#d0d0d0'><b>{}</b></span>",
        "weekdays": "<span color='#7fb069'><b>{}</b></span>",
        "today":    "<span color='#111111' background='#7fb069'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/powermenu.sh"
  }
}
