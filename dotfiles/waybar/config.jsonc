// ~/.config/waybar/config.jsonc — barra vertical à esquerda
{
  "layer": "top",
  "position": "left",
  "output": "DP-1",
  "width": 46,
  "spacing": 0,
  "modules-left": [
    "sway/workspaces",
    "sway/mode"
  ],
  "modules-center": [],
  "modules-right": [
    "tray",
    "network",
    "pulseaudio",
    "cpu",
    "memory",
    "clock#date",
    "clock",
    "custom/power"
  ],
  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "format": "{name}"
  },
  "sway/mode": {
    "format": "{}",
    "rotate": 90
  },
  "tray": {
    "icon-size": 16,
    "spacing": 10
  },
  "network": {
    "format-ethernet": "󰈀",
    "format-wifi": "\n{signalStrength}",
    "format-disconnected": "",
    "tooltip-format-ethernet": "{ifname}  {ipaddr}",
    "tooltip-format-wifi": "{essid}  {ipaddr}",
    "tooltip-format-disconnected": "Sem conexão",
    "justify": "center",
    "on-click": "alacritty -e nmtui"
  },
  "pulseaudio": {
    "format": "{icon}\n{volume}",
    "format-muted": "\nmudo",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "justify": "center",
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "cpu": {
    "format": "\n{usage}",
    "interval": 5,
    "justify": "center"
  },
  "memory": {
    "format": "󰍛\n{percentage}",
    "interval": 10,
    "justify": "center",
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
  },
  "clock#date": {
    "format": "{:%d\n%m}",
    "justify": "center",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "today": "<span color='#7fb069'><b>{}</b></span>"
      }
    }
  },
  "clock": {
    "format": "{:%H\n%M}",
    "interval": 30,
    "justify": "center",
    "tooltip": false
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "swaynag -t warning -m 'Energia' -B 'Desligar' 'systemctl poweroff' -B 'Reiniciar' 'systemctl reboot' -B 'Sair do Sway' 'swaymsg exit'"
  }
}
