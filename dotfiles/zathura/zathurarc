# ~/.config/zathura/zathurarc — fundo transparente (blur do SwayFX), cores do wallust

set font                 "JetBrainsMono Nerd Font 10"
set selection-clipboard  clipboard
set adjust-open          "best-fit"
set pages-per-row        1
set scroll-page-aware    true
set scroll-step          60
set zoom-min             10
set guioptions           ""
set window-title-basename true
set statusbar-h-padding  12
set statusbar-v-padding  4
set page-v-padding       6
set page-h-padding       6
set database             "sqlite"

# Modo escuro para leitura (Ctrl+R alterna — atalho padrão): página transparente,
# texto na cor clara do tema e imagens com as cores originais
set recolor-keephue      true
set recolor-reverse-video true
# Cores geradas pelo wallust a partir do wallpaper (precisam vir antes do recolor)
include /home/arthur/.cache/wallust/zathura
set recolor              true

# Atalhos extras
map D     toggle_page_mode
